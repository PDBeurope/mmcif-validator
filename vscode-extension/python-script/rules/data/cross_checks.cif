_validator_rule_date_order.id
_validator_rule_date_order.category
_validator_rule_date_order.left_item
_validator_rule_date_order.right_item
_validator_rule_date_order.op
_validator_rule_date_order.severity
_validator_rule_date_order.message
date_pdbx_database_status_recvd_initial_deposition_date_1 pdbx_database_status recvd_initial_deposition_date date_coordinates <= hard
;Initial deposition date must not be after the date coordinates were received (coordinates date: [{right_value}]).
;
date_pdbx_database_status_recvd_initial_deposition_date_2 pdbx_database_status recvd_initial_deposition_date date_author_release_request <= hard
;Initial deposition date must not be after the author release request date (release request date: [{right_value}]).
;
date_pdbx_database_status_date_deposition_form_3 pdbx_database_status date_deposition_form recvd_initial_deposition_date <= hard
;Deposition form date must not be after the initial deposition received date (initial deposition date: [{right_value}]).
;
date_pdbx_database_status_date_begin_deposition_4 pdbx_database_status date_begin_deposition date_end_processing <= hard
;Begin processing date must not be after end processing date (end processing date: [{right_value}]).
;
#
