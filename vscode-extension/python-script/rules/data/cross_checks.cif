linked_refine_ls_r_factor_r_work_1 refine ls_R_factor_R_work refine ls_R_factor_R_free pdbx_diffrn_id . > single_row_if_key_missing . yes .
;R_work is higher than R_free [{item2CrossValue}]
;
linked_refine_ls_d_res_high_1 refine ls_d_res_high reflns d_resolution_high pdbx_diffrn_id . < single_row_if_key_missing . . .
;Refined high-resolution limit is higher than collected data high-resolution limit [{item2CrossValue}]
;
linked_refine_ls_d_res_high_2 refine ls_d_res_high refine ls_d_res_low pdbx_diffrn_id . > single_row_if_key_missing . . .
;Refined high-resolution limit is lower than refined low-resolution limit [{item2CrossValue}]
;
linked_refine_ls_d_res_low_1 refine ls_d_res_low reflns d_resolution_low pdbx_diffrn_id . > single_row_if_key_missing . . .
;Refined low-resolution limit is lower than collected data low-resolution limit [{item2CrossValue}]
;
linked_refine_ls_d_res_low_2 refine ls_d_res_low refine ls_d_res_high pdbx_refine_id . < . . . .
;Refined low-resolution limit is higher than refined high-resolution limit [{item2CrossValue}]
;
linked_refine_ls_shell_d_res_high_1 refine_ls_shell d_res_high refine ls_d_res_high pdbx_refine_id . < . . . .
;Shell high-resolution limit is higher than overall refined high-resolution limit [{item2CrossValue}]
;
linked_refine_ls_shell_d_res_low_1 refine_ls_shell d_res_low refine ls_d_res_low pdbx_refine_id . > . . . .
;Shell low-resolution limit is lower than overall refined low-resolution limit [{item2CrossValue}]
;
linked_reflns_d_resolution_high_1 reflns d_resolution_high refine ls_d_res_high pdbx_diffrn_id . > single_row_if_key_missing . . .
;Collected data high-resolution limit is lower than high-resolution limit used in refinement [{item2CrossValue}]
;
linked_reflns_d_resolution_low_1 reflns d_resolution_low refine ls_d_res_low pdbx_diffrn_id . < single_row_if_key_missing . . .
;Collected data low-resolution limit is higher than low-resolution limit used in refinement [{item2CrossValue}]
;
linked_reflns_number_all_1 reflns number_all refine ls_number_reflns_obs pdbx_diffrn_id . < single_row_if_key_missing . . .
;Total collected reflections is lower than total reflections used in refinement [{item2CrossValue}]
;
linked_reflns_number_obs_1 reflns number_obs refine ls_number_reflns_obs pdbx_diffrn_id . < single_row_if_key_missing . . .
;Observed reflections is lower than total reflections used in refinement [{item2CrossValue}]
;
linked_reflns_shell_d_res_high_1 reflns_shell d_res_high reflns d_resolution_high pdbx_diffrn_id . < single_row_if_key_missing . . .
;Shell high-resolution limit is higher than overall collected data high-resolution limit [{item2CrossValue}]
;
