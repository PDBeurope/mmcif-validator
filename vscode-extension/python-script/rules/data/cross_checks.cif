_validator_rule_uniqueness.id
_validator_rule_uniqueness.category
_validator_rule_uniqueness.severity
_validator_rule_uniqueness.message
uniq_entity_1 entity hard
;Duplicate _entity.id in this file: [{duplicate_display}]. Each entity id must appear at most once.
;
uniq_struct_asym_2 struct_asym hard
;Duplicate _struct_asym.id in this file: [{duplicate_display}]. Each chain (asym) id must appear at most once.
;
uniq_entity_poly_3 entity_poly hard
;Duplicate _entity_poly.entity_id in this file: [{duplicate_display}]. Each polymer entity must have at most one entity_poly row.
;
#
